# --- Server ---------------------------------------------------
PORT=3000
HOST=0.0.0.0
# development | production. Production requires authentication (see API_KEYS).
NODE_ENV=development
# Number of reverse-proxy hops in front of this service (client IP resolution).
# Applied only when NODE_ENV=production.
TRUST_PROXY_HOPS=1
# debug | info | warn | error
LOG_LEVEL=info

# --- Authentication -------------------------------------------
# Comma-separated API keys. When set, every endpoint except /healthz, /readyz,
# /health and /docs requires a key.
#
# Accepted on the wire in any of these forms:
#   x-api-key: <key>            (presented directly)
#   Authorization: Bearer <key>
#   <API_KEY_HEADER>: <key>     (configurable)
#
# In production the server REFUSES TO START without keys unless you explicitly set
# ALLOW_UNAUTHENTICATED=true. An open image proxy spends your provider credits.
# API_KEYS=your-secret-key-1,your-secret-key-2
API_KEY_HEADER=x-api-key
ALLOW_UNAUTHENTICATED=false

# --- CORS -----------------------------------------------------
# Comma-separated origins. Defaults to "*" outside production and to none inside
# production, where an explicit list is expected.
CORS_ORIGINS=*

# --- Rate Limiting --------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# --- Engine ---------------------------------------------------
# Global cap on concurrent upstream generation calls. Bounds total upstream load
# regardless of how many images one request asks for.
MAX_GENERATION_CONCURRENCY=10

# --- Provider: chat-completions model -------------------------
# RenderMind's single upstream class. It sends POST {CHAT_BASE_URL}/chat/completions
# and instructs the model to answer with an image.
#
# The API key is REQUIRED for the provider to register; a base URL alone is never
# advertised as available.
CHAT_API_KEY=
CHAT_BASE_URL=https://api.openai.com/v1
# Model used for text-only generation (/chat).
CHAT_MODEL=gpt-4o
# Model used when the request carries input images (/vision). Falls back to CHAT_MODEL.
CHAT_VISION_MODEL=
# Extra model ids this endpoint accepts, comma-separated.
CHAT_EXTRA_MODELS=
# Replaces the built-in "answer with an image" system instruction. Leave unset to use it.
# CHAT_SYSTEM_PROMPT=You are an image generation backend...

# --- Redis (optional) -----------------------------------------
# Used for caching and generation records. The service runs correctly without it,
# falling back to an in-memory tier, so Redis is NOT required for readiness.
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600
# Set to true if you want /readyz to fail when Redis is unreachable.
HEALTH_REQUIRE_REDIS=false

# --- Response metadata ----------------------------------------
# Emit the non-standard "_rendermind" metadata object on responses. Off by default:
# strict response-schema validators reject unknown fields.
OPENAI_RESPONSE_METADATA=false

# --- Webhooks -------------------------------------------------
# When set, outgoing webhook payloads are signed with HMAC-SHA256.
# WEBHOOK_SECRET=your-webhook-secret
