# ─── Server ────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ─── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# ─── Backend: Stability AI (Stable Diffusion) ──────────────
STABILITY_API_KEY=
STABILITY_API_HOST=https://api.stability.ai

# ─── Backend: openclaw (DALL-E 3) ──────────────────────────
OPENAI_API_KEY=

# ─── Backend: Replicate (Flux) ─────────────────────────────
REPLICATE_API_TOKEN=

# ─── Backend: Custom HTTP endpoints ────────────────────────
# CUSTOM_BACKENDS='[{"name":"my-api","url":"https://my-api.com/generate","apiKey":"..."}]'

# ─── Redis (Cache & Queue) ─────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Cache ──────────────────────────────────────────────────
CACHE_TTL=3600

# ─── Queue ──────────────────────────────────────────────────
QUEUE_CONCURRENCY=5

# ─── Webhooks ──────────────────────────────────────────────
# WEBHOOK_SECRET=your-webhook-secret
