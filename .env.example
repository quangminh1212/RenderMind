# ─── Server ────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ─── Authentication (optional but recommended for production)
# Comma-separated list of API keys. If set, all /api/* requests require x-api-key header.
# API_KEYS=your-secret-key-1,your-secret-key-2
# API_KEY_HEADER=x-api-key

# ─── CORS ──────────────────────────────────────────────────
# Comma-separated origins. Use * for public API, or specific domains for production.
CORS_ORIGINS=*

# ─── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# ─── Backend: Stability AI (Stable Diffusion) ──────────────
STABILITY_API_KEY=
STABILITY_API_HOST=https://api.stability.ai

# ─── Backend: openclaw-compatible image API (RECOMMENDED) ──
# THE "real" image generator the bridge forwards to. Works with api.openai.com,
# Azure openclaw, LM Studio, LocalAI, or any endpoint that speaks
# POST {OPENAI_BASE_URL}/images/generations.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=dall-e-3

# ─── Backend: Replicate (Flux) ─────────────────────────────
REPLICATE_API_TOKEN=

# ─── Redis (Cache & Queue) ─────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Cache ──────────────────────────────────────────────────
CACHE_TTL=3600

# ─── Queue ──────────────────────────────────────────────────
QUEUE_CONCURRENCY=5

# ─── Webhooks ──────────────────────────────────────────────
# WEBHOOK_SECRET=your-webhook-secret
