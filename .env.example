# --- Server ---------------------------------------------------
PORT=3000
HOST=0.0.0.0
# development | production. Production requires authentication (see API_KEYS).
NODE_ENV=development
# Number of reverse-proxy hops in front of this service (client IP resolution).
# Applied only when NODE_ENV=production.
TRUST_PROXY_HOPS=1
# debug | info | warn | error
LOG_LEVEL=info

# --- Authentication -------------------------------------------
# Comma-separated API keys. When set, every endpoint except /healthz, /readyz,
# /health, /docs and /api/v1/backends requires a key.
#
# Accepted on the wire in any of these forms:
#   x-api-key: <key>              (Anthropic's own header)
#   Authorization: Bearer <key>   (openclaw's idiom)
#   <API_KEY_HEADER>: <key>       (configurable)
#
# In production the server REFUSES TO START without keys unless you explicitly set
# ALLOW_UNAUTHENTICATED=true. An open image proxy spends your provider credits.
# API_KEYS=your-secret-key-1,your-secret-key-2
API_KEY_HEADER=x-api-key
ALLOW_UNAUTHENTICATED=false

# --- CORS -----------------------------------------------------
# Comma-separated origins. Defaults to "*" outside production and to none inside
# production, where an explicit list is expected.
CORS_ORIGINS=*

# --- Rate Limiting --------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# --- Engine ---------------------------------------------------
# Global cap on concurrent upstream generation calls. Bounds total upstream load
# regardless of how many images one request asks for.
MAX_GENERATION_CONCURRENCY=10

# --- Provider: openclaw-compatible image API ------------------
# Sends POST {OPENAI_BASE_URL}/images/generations with Bearer auth.
#
# NOTE ON NAMING: this project calls this provider "openclaw". It speaks the same
# protocol openclaw's image API exposes and is used for api.openai.com, Azure
# openclaw, LM Studio, LocalAI, or any compatible image service. The name refers
# to the protocol, not to a specific vendor. See docs/providers.md.
#
# The API key is REQUIRED for the provider to register; a base URL alone will not
# be advertised as available.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=dall-e-3
# Extra model ids this endpoint accepts, comma-separated. Unknown models are
# assumed to accept arbitrary sizes rather than DALL-E's discrete buckets.
OPENAI_EXTRA_MODELS=

# --- Provider: Stability AI (Stable Diffusion) ----------------
STABILITY_API_KEY=
STABILITY_API_HOST=https://api.stability.ai

# --- Provider: Replicate (Flux) -------------------------------
REPLICATE_API_TOKEN=

# --- Provider: custom HTTP endpoints --------------------------
# JSON array. Each entry registers a provider that receives a POST of the
# generation payload. Optional body_template uses {{placeholders}}.
# CUSTOM_BACKENDS=[{"name":"my-sd","url":"http://localhost:7860/generate","models":["sdxl"]}]

# --- Redis (optional) -----------------------------------------
# Used for caching and generation records. The service runs correctly without it,
# falling back to an in-memory tier, so Redis is NOT required for readiness.
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600
# Set to true if you want /readyz to fail when Redis is unreachable.
HEALTH_REQUIRE_REDIS=false

# --- Protocol bridges -----------------------------------------
# Anthropic response image delivery:
#   off       (default) respond with a tool_use block for generate_image.
#             This is the only shape valid against the Anthropic response
#             ContentBlock union, so keep it for real SDK clients.
#   extension respond with an image content block. Useful for custom clients that
#             opt in, but strict SDK type validation will reject it.
ANTHROPIC_IMAGE_BLOCK_MODE=off

# Emit the non-standard "_rendermind" metadata object on openclaw responses.
# Off by default: strict response-schema validators reject unknown fields.
OPENAI_RESPONSE_METADATA=false

# --- Webhooks -------------------------------------------------
# When set, outgoing webhook payloads are signed with HMAC-SHA256.
# WEBHOOK_SECRET=your-webhook-secret
