# --- Server ---------------------------------------------------
PORT=3000
HOST=0.0.0.0
# development | production. Production requires authentication (see API_KEYS).
NODE_ENV=development
# Number of reverse-proxy hops in front of this service (client IP resolution).
# Applied only when NODE_ENV=production. Clamped to [0, 10].
TRUST_PROXY_HOPS=1
# debug | info | warn | error
LOG_LEVEL=info

# --- Authentication -------------------------------------------
# Comma-separated API keys. When set, every endpoint except /healthz, /readyz,
# /health and /docs requires a key.
#
# Accepted on the wire in any of these forms:
#   x-api-key: <key>            (presented directly)
#   Authorization: Bearer <key>
#   <API_KEY_HEADER>: <key>     (configurable)
#
# In production the server REFUSES TO START without keys unless you explicitly set
# ALLOW_UNAUTHENTICATED=true. An open image proxy spends your provider credits.
# API_KEYS=your-secret-key-1,your-secret-key-2
API_KEY_HEADER=x-api-key
ALLOW_UNAUTHENTICATED=false

# --- CORS -----------------------------------------------------
# Comma-separated origins. Defaults to "*" outside production and to none inside
# production, where an explicit list is expected.
CORS_ORIGINS=*

# --- Rate Limiting --------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# --- Engine ---------------------------------------------------
# Global cap on concurrent upstream generation calls. Bounds total upstream load
# regardless of how many images one request asks for.
MAX_GENERATION_CONCURRENCY=10

# --- Provider: chat-completions model -------------------------
# RenderMind's fallback upstream, and the only one that needs no image-capable backend. It
# sends POST {CHAT_BASE_URL}/chat/completions and instructs the model to answer with an
# image (vector markup, rasterized before delivery).
#
# The API key is REQUIRED for the provider to register; a base URL alone is never
# advertised as available.
#
# This path is also the only source of:
#   - format=svg requests (real vector output a client can edit and rescale)
#   - /vision requests (the native images endpoint has no image-input parameter)
CHAT_API_KEY=
CHAT_BASE_URL=https://api.openai.com/v1
# Model used for text-only generation (/chat).
CHAT_MODEL=gpt-4o
# Completion-token budget for the SVG drawing/revision turn. 8192 gives text-only models
# enough room to finish a detailed SVG; the hard maximum is 16384.
CHAT_MAX_TOKENS=8192
# Model used when the request carries input images (/vision). Set this explicitly to a model
# you have verified accepts image input; leaving it blank does not advertise vision support.
CHAT_VISION_MODEL=
# Optional: extra review + revision passes on the chat path. 0 (the default) means the
# provider makes exactly the one call it always has.
#
# When set above 0 AND CHAT_VISION_MODEL is set, RenderMind renders each drawing it just
# produced and sends that PNG to the vision model with a strict JSON review prompt. If the
# reviewer reports concrete visual defects, the drawing model is asked to revise the SVG
# using that critique, up to this many times.
#
# What it costs: each round is TWO extra upstream calls plus a local render, so a request
# that previously cost one call can cost 1 + 2*rounds. Round 1 therefore triples the call
# count. Only the chat path refines; the native provider is never refined.
#
# What it does NOT change: a drawing is only ever replaced by a revision that passes the same
# SVG gate as the original. If the review or revision fails for any reason, the last valid
# drawing is delivered and nothing is reported that did not happen. If the initial
# generation fails, it still fails — the pass never invents a success.
#
# The revision is a fresh drawing that carries the previous document and the critique, so
# the drawing model is not asked to remember what it no longer has in context.
#
# Maximum is 5; anything higher (or any non-integer) is a startup error rather than a clamp.
CHAT_VISION_REFINEMENT_ROUNDS=0
# Extra model ids this endpoint accepts, comma-separated.
CHAT_EXTRA_MODELS=
# Replaces the built-in "answer with an image" system instruction. Leave unset to use it.
# CHAT_SYSTEM_PROMPT=You are an image generation backend...
#
# How the model is asked to describe a picture. "svg" (the default) asks for one complete
# SVG document and extracts it; "scene" asks for a compact JSON scene (layers of typed
# geometry) that RenderMind validates with its own compiler and only then renders. Scene mode
# never asks a model for pixels, base64 or raw SVG, so a reply cannot smuggle markup: the
# object is data, and the document is written by RenderMind. A scene that fails validation
# gets one bounded repair turn and is otherwise reported as a truthful unsupported_output
# (HTTP 422), never rendered in part. Both modes honour the requested output format
# (CHAT default png, or format=svg), and "svg" mode is byte-identical to a build without this
# setting. An unrecognised value is a startup error, not a silent fallback.
CHAT_RENDER_MODE=svg

# --- Provider: native image endpoint --------------------------
# A real image-generation endpoint, POST {IMAGE_BASE_URL}/images/generations — the shape
# LiteLLM exposes for DALL-E, gpt-image-1, Imagen, Bedrock, Stability, Flux and others.
# Unlike the chat path it returns actual pixels rather than a drawing a language model
# composed, so it is preferred whenever it is configured.
#
# Registered ONLY when BOTH IMAGE_API_KEY and IMAGE_MODEL are set. There is no default
# model: a guessed model id would 404 on every request, so a half-configured endpoint is
# reported as unconfigured rather than advertised as available.
#
# What it does NOT do, and does not claim:
#   - no SVG output (use the chat path for format=svg)
#   - no image-to-image (use /vision, which routes to the chat path)
#
# The caller's response_format is honoured by RenderMind, not forwarded: base64 is always
# requested upstream and a URL result is fetched and inlined, because the SSRF-guarded
# inliner is the only place that can do that safely and some vendors ignore the field.
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=
# Extra model ids this endpoint accepts, comma-separated.
IMAGE_EXTRA_MODELS=
# Set false when the backend rejects n>1; RenderMind will fan out safely into one request
# per image. The default true is correct for standard openclaw-compatible image APIs.
IMAGE_SUPPORTS_BATCH=true

# --- Optional: LLM prompt expansion (native path only) ---------
# Rewrites a short caller prompt into a richer one before it reaches the native images
# endpoint, using a chat-completions model. Enable by naming a model below.
#
# OFF BY DEFAULT. With IMAGE_PROMPT_PLANNER_MODEL empty, no planner is constructed, no extra
# upstream call is made, and the prompt sent to the image endpoint is byte-identical to a
# build without this feature.
#
# WHAT IT DOES NOT DO: it does not turn a text model into a diffusion model. The image is
# still produced by IMAGE_BASE_URL; the planner only rewrites words on the way in. See the
# optional vision refinement above for the chat path's separate, distinct quality pass.
#
# It applies only when the native endpoint is selected AND the request asks for a single image
# (count === 1). A fan-out already varies the prompt per image via the engine, and two
# rewriters on one prompt fight.
#
# FAILURE IS NOT FATAL: if the planner call fails, times out, or returns something unusable,
# the caller's original prompt is sent and the generation proceeds. A planner can never turn a
# working generation into a failed one, and it never drops the caller's negative prompt,
# style or aspect ratio — those are re-applied to the expanded prompt regardless.
#
# Cost: one extra chat-completions call per single-image native generation. Bounded below.
IMAGE_PROMPT_PLANNER_MODEL=
# Endpoint for the planner model. Defaults to IMAGE_BASE_URL when left blank.
IMAGE_PROMPT_PLANNER_BASE_URL=
# Bearer token for the planner. Defaults to IMAGE_API_KEY when left blank.
IMAGE_PROMPT_PLANNER_API_KEY=
# Completion-token budget for one planner turn. Maximum 4000; the default is ample.
IMAGE_PROMPT_PLANNER_MAX_TOKENS=400

# --- Routing --------------------------------------------------
# Which provider class serves a request:
#   auto   (default) prefer the native endpoint when configured, chat as failover
#   chat   pin the chat-completions path only (identical to a deployment with no native
#          backend, even when one is configured)
#   native native only — format=svg and /vision then have no provider and return 400
#
# An unrecognised value is a startup error, not a silent fallback to auto: a typo here
# would otherwise change which upstream is billed without anyone being told.
PROVIDER_STRATEGY=auto

# --- Redis (optional) -----------------------------------------
# Used for caching. The service runs correctly without it,
# falling back to an in-memory tier, so Redis is NOT required for readiness.
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600
# Set to true if you want /readyz to fail when Redis is unreachable.
HEALTH_REQUIRE_REDIS=false

# --- Response metadata ----------------------------------------
# Emit the non-standard "_rendermind" metadata object on responses. Off by default:
# strict response-schema validators reject unknown fields.
OPENAI_RESPONSE_METADATA=false
